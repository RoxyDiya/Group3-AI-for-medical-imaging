#!/bin/bash
# Slice the full 40-patient release for one preprocessing variant.
#
#   sbatch slice.job baseline
#   sbatch slice.job zscore
#   sbatch slice.job multiwindow
#
# Each variant writes to its own directory, so several can exist side by side
# and be trained at the same time without overwriting each other.
#
# Slicing is CPU-only, so this runs on a CPU partition. The GPU partitions are
# shared across the whole course and should not be used for this.

#SBATCH --job-name=ai4mi_slice
#SBATCH --account=gpuuva084
#SBATCH --partition=rome
#SBATCH --cpus-per-task=16
#SBATCH --time=00:30:00
#SBATCH --output=slurm_logs/%x_%j.out
#SBATCH --error=slurm_logs/%x_%j.err

set -e

# --- The split, agreed by the group -----------------------------------------
# These two decide WHICH patients are held out for validation. Every variant
# and every run must use the same values, or the results cannot be compared.
RETAINS=8      # 8 of 40 held out (20%); also divides 40 into exactly 5 folds
SEED=42
SHAPE="256 256"
SRC_DIR="data/segthor_train_full"
# ----------------------------------------------------------------------------

mkdir -p slurm_logs

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ai4mi_venv/bin/activate

cd "${SLURM_SUBMIT_DIR:-$HOME/Group3-AI-for-medical-imaging}"

VARIANT="${1:?Usage: sbatch slice.job <baseline|zscore|multiwindow|zscore_skip>}"

case "${VARIANT}" in
    baseline)
        # Stock defaults: minmax normalization, every slice kept.
        # This is what every improvement is measured against.
        SLICE_FLAGS=""
        ;;
    zscore)
        # Clip to the HU window then z-score. Every slice kept, because
        # foreground oversampling handles the class balance instead of
        # deleting the empty slices.
        SLICE_FLAGS="--norm_mode zscore"
        ;;
    multiwindow)
        # Three clinical CT windows (mediastinal, lung, wide) as the three
        # channels of each slice, instead of one compromise contrast.
        SLICE_FLAGS="--norm_mode multiwindow"
        ;;
    zscore_skip)
        # The part 1 configuration: z-score AND drop organ-free training
        # slices. Kept so the two approaches to class balance can be compared.
        SLICE_FLAGS="--norm_mode zscore --skip_empty"
        ;;
    *)
        echo "ERROR: unknown variant '${VARIANT}'. Use baseline, zscore, multiwindow or zscore_skip." >&2
        exit 1
        ;;
esac

SLICE_DIR="data/SEGTHOR_${VARIANT}"

echo "=== Slice job $SLURM_JOB_ID, variant ${VARIANT}, starting at $(date) ==="
echo ">>> Source:      ${SRC_DIR}"
echo ">>> Destination: ${SLICE_DIR}"
echo ">>> Flags:       '${SLICE_FLAGS}'"
echo ">>> Split:       --retains ${RETAINS} --seed ${SEED}"

if [ ! -d "${SRC_DIR}/train" ]; then
    echo "ERROR: ${SRC_DIR}/train not found. Is the dataset uploaded?" >&2
    exit 1
fi

if [ -d "${SLICE_DIR}" ]; then
    echo ">>> Removing existing ${SLICE_DIR}"
    rm -rf "${SLICE_DIR}"
fi

python -u slice_segthor.py \
    --source_dir "${SRC_DIR}" \
    --dest_dir "${SLICE_DIR}" \
    --shape ${SHAPE} \
    --retains ${RETAINS} \
    --seed ${SEED} \
    --process -1 \
    ${SLICE_FLAGS}

echo ">>> Slice counts (everyone using the same parameters must get these):"
echo "    train img: $(ls ${SLICE_DIR}/train/img | wc -l)"
echo "    val   img: $(ls ${SLICE_DIR}/val/img   | wc -l)"

echo "=== Slice job $SLURM_JOB_ID, variant ${VARIANT}, finished at $(date) ==="